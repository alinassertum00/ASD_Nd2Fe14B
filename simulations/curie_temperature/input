#------------------------------------------
# Nd2Fe14B site-resolved model
# Magnetisation / Curie-temperature run
# Uses normal Monte Carlo and can run in parallel.
#------------------------------------------

material:unit-cell-file = Nd2Fe14B_scaled_175.ucf

create:full
create:periodic-boundaries-x
create:periodic-boundaries-y
create:periodic-boundaries-z

# Approximately 10 x 10 x 10 conventional unit cells
dimensions:system-size-x = 8.776 !nm
dimensions:system-size-y = 8.776 !nm
dimensions:system-size-z = 12.119 !nm

material:file = Nd2Fe14B.mat

sim:minimum-temperature = 0
sim:maximum-temperature = 610
sim:temperature-increment = 10

sim:equilibration-time-steps = 20000
sim:loop-time-steps = 50000
sim:time-steps-increment = 1

sim:program = curie-temperature
sim:integrator = monte-carlo

output:temperature
output:mean-magnetisation-length
output:mean-magnetisation
output:material-mean-magnetisation-length
output:material-mean-magnetisation
output:mean-susceptibility
output:mean-specific-heat
output:mean-total-energy
output:mean-exchange-energy
output:mean-anisotropy-energy
